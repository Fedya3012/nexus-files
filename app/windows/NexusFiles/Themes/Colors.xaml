<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus design tokens, taken from the approved mockups (mockups/app.html). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent used by built-in controls (buttons, focus, progress). -->
    <Color x:Key="SystemAccentColor">#5B5BF6</Color>
    <Color x:Key="SystemAccentColorLight1">#7474F8</Color>
    <Color x:Key="SystemAccentColorLight2">#9C9CFF</Color>
    <Color x:Key="SystemAccentColorLight3">#B4B4FF</Color>
    <Color x:Key="SystemAccentColorDark1">#4B45E6</Color>
    <Color x:Key="SystemAccentColorDark2">#3B33D4</Color>
    <Color x:Key="SystemAccentColorDark3">#2C25B0</Color>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NxBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NxSidebar" Color="#F0F0F5" />
            <SolidColorBrush x:Key="NxElevated" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NxHover" Color="#E6E6EE" />
            <SolidColorBrush x:Key="NxSelected" Color="#DCDCFC" />
            <SolidColorBrush x:Key="NxBorderSubtle" Color="#C8C8D4" />
            <SolidColorBrush x:Key="NxBorderStrong" Color="#8E8E9E" />
            <SolidColorBrush x:Key="NxAccent" Color="#5B5BF6" />
            <SolidColorBrush x:Key="NxAccentText" Color="#3B33D4" />
            <SolidColorBrush x:Key="NxOnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NxAccentSoft" Color="#EEEEFE" />
            <SolidColorBrush x:Key="NxText1" Color="#0B0B12" />
            <SolidColorBrush x:Key="NxText2" Color="#3E3E4C" />
            <SolidColorBrush x:Key="NxText3" Color="#80808F" />
            <SolidColorBrush x:Key="NxOk" Color="#11793F" />
            <SolidColorBrush x:Key="NxWarn" Color="#8A5600" />
            <SolidColorBrush x:Key="NxBad" Color="#BF1D1D" />
            <SolidColorBrush x:Key="NxInfo" Color="#0D62AD" />
            <SolidColorBrush x:Key="NxFolder" Color="#6E6CF0" />
            <SolidColorBrush x:Key="NxFolderFill" Color="#E3E2FD" />
            <SolidColorBrush x:Key="NxScrim" Color="#660B0B12" />
            <!-- Built-in list selection colours, matched to the mockup. -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#E6E6EE" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#DCDCFC" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#D2D2FA" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#C8C8F8" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#E6E6EE" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#DCDCFC" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#D2D2FA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NxBackground" Color="#121216" />
            <SolidColorBrush x:Key="NxSidebar" Color="#1B1B21" />
            <SolidColorBrush x:Key="NxElevated" Color="#24242C" />
            <SolidColorBrush x:Key="NxHover" Color="#2C2C36" />
            <SolidColorBrush x:Key="NxSelected" Color="#33327A" />
            <SolidColorBrush x:Key="NxBorderSubtle" Color="#44444F" />
            <SolidColorBrush x:Key="NxBorderStrong" Color="#6E6E7C" />
            <SolidColorBrush x:Key="NxAccent" Color="#9C9CFF" />
            <SolidColorBrush x:Key="NxAccentText" Color="#B4B4FF" />
            <SolidColorBrush x:Key="NxOnAccent" Color="#0B0B2E" />
            <SolidColorBrush x:Key="NxAccentSoft" Color="#25244F" />
            <SolidColorBrush x:Key="NxText1" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NxText2" Color="#C6C6D3" />
            <SolidColorBrush x:Key="NxText3" Color="#7A7A88" />
            <SolidColorBrush x:Key="NxOk" Color="#5BD997" />
            <SolidColorBrush x:Key="NxWarn" Color="#FFC24D" />
            <SolidColorBrush x:Key="NxBad" Color="#FF8585" />
            <SolidColorBrush x:Key="NxInfo" Color="#74BFFF" />
            <SolidColorBrush x:Key="NxFolder" Color="#A9A8FF" />
            <SolidColorBrush x:Key="NxFolderFill" Color="#34336E" />
            <SolidColorBrush x:Key="NxScrim" Color="#99000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2C2C36" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#33327A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3B3A88" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#424194" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#2C2C36" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#33327A" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#3B3A88" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NxBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NxSidebar" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NxElevated" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NxHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NxSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NxBorderSubtle" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NxBorderStrong" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NxAccent" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NxAccentText" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NxOnAccent" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NxAccentSoft" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NxText1" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NxText2" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NxText3" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="NxOk" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NxWarn" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NxBad" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NxInfo" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NxFolder" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NxFolderFill" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NxScrim" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
