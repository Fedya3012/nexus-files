<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NexusFiles.Controls.Inspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource NxBackground}" BorderBrush="{ThemeResource NxBorderSubtle}" BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar x:Name="Tabs" Padding="8,2,8,0" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="DetailsTab" Text="Chi tiết" IsSelected="True" />
            <SelectorBarItem x:Name="PreviewTab" Text="Xem trước" />
        </SelectorBar>

        <ScrollViewer Grid.Row="1" Padding="16,8,16,16" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Spacing="14">
                <!-- Visual: image, PDF page, video, text, or a big glyph. -->
                <Border x:Name="VisualFrame" CornerRadius="8" Background="{ThemeResource NxSidebar}" MinHeight="160" MaxHeight="420">
                    <Grid>
                        <FontIcon x:Name="BigIcon" FontSize="64" Glyph="&#xE8B7;" Foreground="{ThemeResource NxFolder}" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                        <MediaPlayerElement x:Name="Media" AreTransportControlsEnabled="True" Visibility="Collapsed" />
                        <ScrollViewer x:Name="TextScroller" Visibility="Collapsed" Padding="12" HorizontalScrollBarVisibility="Auto" MaxHeight="420">
                            <TextBlock x:Name="PreviewText" FontFamily="{StaticResource NxMono}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Spacing="2">
                    <TextBlock x:Name="NameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource NxText2}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenButton" Style="{StaticResource AccentButtonStyle}" Click="OnOpen">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Mở" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnShowInExplorer" ToolTipService.ToolTip="Mở trong File Explorer">
                        <FontIcon Glyph="&#xEC50;" FontSize="14" />
                    </Button>
                    <Button Click="OnProperties" ToolTipService.ToolTip="Thuộc tính">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                    </Button>
                </StackPanel>

                <TextBlock Text="THÔNG TIN" Style="{StaticResource NxSectionHeader}" Margin="0,4,0,0" />
                <Grid x:Name="InfoGrid" ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <StackPanel x:Name="FolderList" Spacing="4" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="Placeholder" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE946;" FontSize="32" Foreground="{ThemeResource NxText3}" />
            <TextBlock x:Name="PlaceholderText" Text="Chọn một mục để xem chi tiết" Foreground="{ThemeResource NxText2}" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
