<?xml version="1.0" encoding="utf-8"?>
<!-- Omnibar overlay (mockup 03): search, GoTo (@), commands (>), path. -->
<UserControl
    x:Class="NexusFiles.Controls.Omnibar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexusFiles.ViewModels"
    xmlns:local="using:NexusFiles.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="HeaderTemplate" x:DataType="vm:OmniItem">
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource NxSectionHeader}" Margin="4,10,0,4" />
        </DataTemplate>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:OmniItem">
            <Grid ColumnSpacing="12" Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind GlyphBrush}" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock local:Highlight.Item="{Binding}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" FontFamily="{StaticResource NxMono}" FontSize="11.5" Foreground="{ThemeResource NxText3}"
                               TextTrimming="CharacterEllipsis" Visibility="{x:Bind local:Bind.VisibleIfText(Subtitle)}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource NxText2}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource NxKeyHint}" Visibility="{x:Bind local:Bind.VisibleIfText(Shortcut)}">
                        <TextBlock Text="{x:Bind Shortcut}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <local:OmniTemplateSelector x:Key="Selector" Header="{StaticResource HeaderTemplate}" Row="{StaticResource RowTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="Scrim" Background="{ThemeResource NxScrim}" PointerPressed="OnScrimPressed">
        <Border x:Name="Card" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,96,16,16"
                Width="820" MaxHeight="640" CornerRadius="12"
                Background="{ThemeResource NxElevated}" BorderBrush="{ThemeResource NxBorderSubtle}" BorderThickness="1"
                PointerPressed="OnCardPressed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="16,10" ColumnSpacing="10" BorderBrush="{ThemeResource NxBorderSubtle}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource NxAccent}" />
                    <ItemsControl x:Name="Chips" Grid.Column="1" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBox x:Name="Input" Grid.Column="2" FontSize="18" BorderThickness="0" Background="Transparent"
                             PlaceholderText="Tìm file, gõ đường dẫn, @ để đi tới, &gt; để chạy lệnh"
                             TextChanged="OnTextChanged" PreviewKeyDown="OnInputKeyDown" />
                </Grid>

                <Grid Grid.Row="1" Padding="16,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Phạm vi:" FontSize="12" Foreground="{ThemeResource NxText2}" VerticalAlignment="Center" />
                        <Border Background="{ThemeResource NxAccent}" CornerRadius="12" Padding="10,3">
                            <TextBlock x:Name="ScopeText" Text="Thư mục hiện tại" FontSize="12" Foreground="{ThemeResource NxOnAccent}" />
                        </Border>
                        <Border BorderBrush="{ThemeResource NxBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="10,2"
                                ToolTipService.ToolTip="Tìm toàn máy tức thì có ở bản Beta (chỉ mục ổ đĩa)">
                            <TextBlock Text="Toàn máy · Beta" FontSize="12" Foreground="{ThemeResource NxText3}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" FontSize="12" Foreground="{ThemeResource NxText3}" VerticalAlignment="Center"
                               Text="Gợi ý: &gt; lệnh · @ đi tới · ext:pdf · size:&gt;10mb · sửa:7d" />
                </Grid>

                <ListView x:Name="Results" Grid.Row="2" Padding="8,0,8,8" SelectionMode="Single"
                          ItemTemplateSelector="{StaticResource Selector}" IsItemClickEnabled="True" ItemClick="OnItemClick"
                          ContainerContentChanging="OnContainerChanging" />
                <TextBlock x:Name="StatusText" Grid.Row="2" Margin="24,16" Foreground="{ThemeResource NxText2}" TextWrapping="Wrap" Visibility="Collapsed" />

                <Grid Grid.Row="3" Padding="16,8" BorderBrush="{ThemeResource NxBorderSubtle}" BorderThickness="0,1,0,0" ColumnSpacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="5"><Border Style="{StaticResource NxKeyHint}"><TextBlock Text="↑↓" FontSize="11" /></Border><TextBlock Text="chọn" FontSize="12" Foreground="{ThemeResource NxText2}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5"><Border Style="{StaticResource NxKeyHint}"><TextBlock Text="Enter" FontSize="11" /></Border><TextBlock Text="mở" FontSize="12" Foreground="{ThemeResource NxText2}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5"><Border Style="{StaticResource NxKeyHint}"><TextBlock Text="Ctrl Enter" FontSize="11" /></Border><TextBlock Text="tab mới" FontSize="12" Foreground="{ThemeResource NxText2}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5"><Border Style="{StaticResource NxKeyHint}"><TextBlock Text="Shift Enter" FontSize="11" /></Border><TextBlock Text="pane bên" FontSize="12" Foreground="{ThemeResource NxText2}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5"><Border Style="{StaticResource NxKeyHint}"><TextBlock Text="Alt Enter" FontSize="11" /></Border><TextBlock Text="chỉ ra trong thư mục" FontSize="12" Foreground="{ThemeResource NxText2}" /></StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                        <Border Style="{StaticResource NxKeyHint}"><TextBlock Text="Esc" FontSize="11" /></Border>
                        <TextBlock Text="đóng" FontSize="12" Foreground="{ThemeResource NxText2}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
