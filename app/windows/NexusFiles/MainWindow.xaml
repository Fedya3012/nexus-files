<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NexusFiles.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NexusFiles.Controls"
    xmlns:vm="using:NexusFiles.ViewModels"
    Title="Nexus Files">

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <DataTemplate x:Key="SidebarTemplate" x:DataType="vm:SidebarItem">
                <Grid ColumnSpacing="10" Padding="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                        <ProgressBar Value="{x:Bind UsagePercent}" Maximum="100" Visibility="{x:Bind controls:Bind.Visible(ShowUsage)}"
                                     Foreground="{x:Bind controls:MainWindowBind.UsageBrush(IsLow)}" />
                        <TextBlock Text="{x:Bind UsageText}" FontSize="11" Visibility="{x:Bind controls:Bind.Visible(ShowUsage)}"
                                   Foreground="{x:Bind controls:MainWindowBind.UsageTextBrush(IsLow)}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="SidebarItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0,10,0" />
                <Setter Property="Margin" Value="6,0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Row 0: tabs in the title bar. -->
        <TabView x:Name="TabStrip" Grid.Row="0" IsAddTabButtonVisible="True" CanReorderTabs="True" CanDragTabs="False"
                 TabWidthMode="Equal" VerticalAlignment="Bottom" Padding="0,4,0,0"
                 AddTabButtonClick="OnAddTab" TabCloseRequested="OnTabCloseRequested" SelectionChanged="OnTabSelectionChanged"
                 TabItemsChanged="OnTabItemsChanged">
            <TabView.TabStripHeader>
                <Image Source="ms-appx:///Assets/NexusFiles.png" Width="20" Height="20" Margin="12,0,6,0" />
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="DragRegion" MinWidth="160" Background="Transparent" />
            </TabView.TabStripFooter>
        </TabView>

        <!-- Row 1: navigation + address bar + toggles. -->
        <Grid Grid.Row="1" Padding="8,6,8,6" ColumnSpacing="4" Background="{ThemeResource NxBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackButton" Style="{StaticResource NxIconButton}" Click="OnNavButton" Tag="nav.back" ToolTipService.ToolTip="Quay lại (Alt+←)"><FontIcon Glyph="&#xE72B;" FontSize="14" /></Button>
                <Button x:Name="ForwardButton" Style="{StaticResource NxIconButton}" Click="OnNavButton" Tag="nav.forward" ToolTipService.ToolTip="Tiến tới (Alt+→)"><FontIcon Glyph="&#xE72A;" FontSize="14" /></Button>
                <Button Style="{StaticResource NxIconButton}" Click="OnNavButton" Tag="nav.up" ToolTipService.ToolTip="Lên thư mục cha (Alt+↑)"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                <Button Style="{StaticResource NxIconButton}" Click="OnNavButton" Tag="nav.refresh" ToolTipService.ToolTip="Làm mới (F5)"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
            </StackPanel>

            <Border x:Name="AddressBar" Grid.Column="1" Height="36" CornerRadius="8" Margin="6,0"
                    Background="{ThemeResource NxSidebar}" BorderBrush="{ThemeResource NxBorderSubtle}" BorderThickness="1"
                    Tapped="OnAddressBarTapped">
                <Grid Padding="10,0,6,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource NxText2}" />
                    <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" VerticalAlignment="Center" ItemClicked="OnCrumbClicked" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Tìm hoặc gõ lệnh" FontSize="12" Foreground="{ThemeResource NxText3}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource NxKeyHint}"><TextBlock Text="Ctrl L" FontSize="11" /></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="DualToggle" Style="{StaticResource NxIconToggle}" Click="OnToggleCommand" Tag="view.dual_pane" ToolTipService.ToolTip="Hai pane (Ctrl+Shift+D)"><FontIcon Glyph="&#xE89F;" FontSize="15" /></ToggleButton>
                <ToggleButton x:Name="InspectorToggle" Style="{StaticResource NxIconToggle}" Click="OnToggleCommand" Tag="view.inspector" ToolTipService.ToolTip="Inspector (Ctrl+I)"><FontIcon Glyph="&#xE946;" FontSize="15" /></ToggleButton>
                <Button Style="{StaticResource NxIconButton}" Click="OnNavButton" Tag="app.palette" ToolTipService.ToolTip="Bảng lệnh (Ctrl+Shift+P)"><FontIcon Glyph="&#xE756;" FontSize="15" /></Button>
                <Button x:Name="SettingsButton" Style="{StaticResource NxIconButton}" ToolTipService.ToolTip="Cài đặt">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                    <Button.Flyout>
                        <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight" Opening="OnSettingsOpening">
                            <StackPanel Spacing="10" Width="300">
                                <TextBlock Text="Cài đặt" FontWeight="SemiBold" FontSize="16" />
                                <RadioButtons x:Name="ThemeChoice" Header="Giao diện" SelectionChanged="OnThemeChoice">
                                    <x:String>Theo hệ thống</x:String>
                                    <x:String>Sáng</x:String>
                                    <x:String>Tối</x:String>
                                </RadioButtons>
                                <ToggleSwitch x:Name="HiddenSwitch" Header="Hiện file ẩn" Toggled="OnSettingSwitch" />
                                <ToggleSwitch x:Name="ConfirmSwitch" Header="Hỏi trước khi xóa vào Thùng rác" Toggled="OnSettingSwitch" />
                                <ToggleSwitch x:Name="RestoreSwitch" Header="Mở lại các tab khi khởi động" Toggled="OnSettingSwitch" />
                                <TextBlock x:Name="AboutText" FontSize="11" Foreground="{ThemeResource NxText3}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 2: command toolbar. -->
        <Grid Grid.Row="2" Padding="10,4,10,6" Background="{ThemeResource NxBackground}"
              BorderBrush="{ThemeResource NxBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <DropDownButton Style="{StaticResource AccentButtonStyle}" Padding="12,6" CornerRadius="6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="Mới" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Thư mục" Tag="file.new_folder" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+Shift+N"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Tệp văn bản" Tag="file.new_text" Click="OnMenuCommand"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Style="{StaticResource NxToolbarButton}" Tag="edit.cut" Click="OnNavButton" ToolTipService.ToolTip="Ctrl+X"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C6;" FontSize="14" /><TextBlock Text="Cắt" /></StackPanel></Button>
                <Button Style="{StaticResource NxToolbarButton}" Tag="edit.copy" Click="OnNavButton" ToolTipService.ToolTip="Ctrl+C"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="Copy" /></StackPanel></Button>
                <Button Style="{StaticResource NxToolbarButton}" Tag="edit.paste" Click="OnNavButton" ToolTipService.ToolTip="Ctrl+V"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE77F;" FontSize="14" /><TextBlock Text="Dán" /></StackPanel></Button>
                <Button Style="{StaticResource NxToolbarButton}" Tag="file.rename" Click="OnNavButton" ToolTipService.ToolTip="F2"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8AC;" FontSize="14" /><TextBlock Text="Đổi tên" /></StackPanel></Button>
                <Button Style="{StaticResource NxToolbarButton}" Tag="file.delete" Click="OnNavButton" ToolTipService.ToolTip="Delete (Shift+Delete: xóa vĩnh viễn)"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource NxBad}" /><TextBlock Text="Xóa" Foreground="{ThemeResource NxBad}" /></StackPanel></Button>
                <Border Width="1" Margin="8,6" Background="{ThemeResource NxBorderSubtle}" />
                <DropDownButton Style="{StaticResource NxToolbarDropDown}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8CB;" FontSize="14" /><TextBlock Text="Sắp xếp" /></StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Tên" Tag="sort.name" Click="OnMenuCommand" />
                            <MenuFlyoutItem Text="Ngày sửa" Tag="sort.modified" Click="OnMenuCommand" />
                            <MenuFlyoutItem Text="Loại" Tag="sort.type" Click="OnMenuCommand" />
                            <MenuFlyoutItem Text="Kích thước" Tag="sort.size" Click="OnMenuCommand" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton Style="{StaticResource NxToolbarDropDown}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF0E2;" FontSize="14" /><TextBlock Text="Xem" /></StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Chi tiết" Tag="view.details" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+1" />
                            <MenuFlyoutItem Text="Danh sách" Tag="view.list" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+2" />
                            <MenuFlyoutItem Text="Biểu tượng" Tag="view.icons" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+3" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Hiện/ẩn file ẩn" Tag="view.hidden" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+H" />
                            <MenuFlyoutItem Text="Sidebar" Tag="view.sidebar" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+B" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button x:Name="UndoButton" Style="{StaticResource NxToolbarButton}" Tag="edit.undo" Click="OnNavButton" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7A7;" FontSize="14" /><TextBlock Text="Hoàn tác" /></StackPanel>
                </Button>
                <DropDownButton Style="{StaticResource NxToolbarDropDown}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE712;" FontSize="14" /><TextBlock Text="Thêm" /></StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Chọn tất cả" Tag="edit.select_all" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+A" />
                            <MenuFlyoutItem Text="Đảo vùng chọn" Tag="edit.invert_selection" Click="OnMenuCommand" />
                            <MenuFlyoutItem Text="Sao chép đường dẫn" Tag="file.copy_path" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Ghim thư mục này" Tag="nav.pin" Click="OnMenuCommand" KeyboardAcceleratorTextOverride="Ctrl+D" />
                            <MenuFlyoutItem Text="Mở Terminal tại đây" Tag="file.open_terminal" Click="OnMenuCommand" />
                            <MenuFlyoutItem Text="Mở trong File Explorer" Tag="file.show_in_explorer" Click="OnMenuCommand" />
                            <MenuFlyoutItem Text="Lịch sử thao tác" Tag="app.history" Click="OnMenuCommand" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Row 3: sidebar | panes | inspector. -->
        <Grid x:Name="Body" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                <ColumnDefinition x:Name="SidebarSplitColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitColumn" Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="Sidebar" Background="{ThemeResource NxSidebar}" Padding="0,4,0,12">
                <StackPanel>
                    <TextBlock Text="ĐÃ GHIM" Style="{StaticResource NxSectionHeader}" Margin="18,10,0,4" />
                    <ListView x:Name="PinnedList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSidebarClick"
                              ItemTemplate="{StaticResource SidebarTemplate}" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                              CanReorderItems="True" AllowDrop="True" DragItemsCompleted="OnPinsReordered" ContextRequested="OnSidebarContext" />
                    <TextBlock x:Name="PinHint" Text="Nhấn Ctrl+D để ghim thư mục đang mở" FontSize="12" Margin="18,0,12,4"
                               Foreground="{ThemeResource NxText3}" TextWrapping="Wrap" />
                    <TextBlock Text="THƯ VIỆN" Style="{StaticResource NxSectionHeader}" Margin="18,14,0,4" />
                    <ListView x:Name="LibraryList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSidebarClick"
                              ItemTemplate="{StaticResource SidebarTemplate}" ItemContainerStyle="{StaticResource SidebarItemStyle}" ContextRequested="OnSidebarContext" />
                    <TextBlock Text="Ổ ĐĨA" Style="{StaticResource NxSectionHeader}" Margin="18,14,0,4" />
                    <ListView x:Name="DrivesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSidebarClick"
                              ItemTemplate="{StaticResource SidebarTemplate}" ItemContainerStyle="{StaticResource SidebarItemStyle}" ContextRequested="OnSidebarContext" />
                </StackPanel>
            </ScrollViewer>
            <controls:SplitterBar x:Name="SidebarSplitter" Grid.Column="1" Width="5" />

            <Grid x:Name="PaneHost" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="*" />
                    <ColumnDefinition x:Name="PaneSplitColumn" Width="Auto" />
                    <ColumnDefinition x:Name="RightColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <controls:FilePane x:Name="LeftPane" />
                <controls:SplitterBar x:Name="PaneSplitter" Grid.Column="1" Width="5" Visibility="Collapsed"
                                      Background="{ThemeResource NxBorderSubtle}" />
                <controls:FilePane x:Name="RightPane" Grid.Column="2" Visibility="Collapsed" />
            </Grid>

            <controls:SplitterBar x:Name="InspectorSplitter" Grid.Column="3" Width="5" />
            <controls:Inspector x:Name="InspectorView" Grid.Column="4" />
        </Grid>

        <!-- Row 4: status bar. -->
        <Grid Grid.Row="4" Padding="14,0,10,0" ColumnSpacing="18" Background="{ThemeResource NxSidebar}"
              BorderBrush="{ThemeResource NxBorderSubtle}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="SelectionText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource NxAccentText}" VerticalAlignment="Center" />
            <TextBlock x:Name="PaneText" Grid.Column="2" FontSize="12" Foreground="{ThemeResource NxText2}" VerticalAlignment="Center" />
            <Button x:Name="JobsButton" Grid.Column="4" Visibility="Collapsed" Padding="8,2" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                    <TextBlock x:Name="JobsText" FontSize="12" VerticalAlignment="Center" />
                    <ProgressBar x:Name="JobsProgress" Width="140" Maximum="100" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="JobsFlyout" Placement="TopEdgeAlignedRight">
                        <StackPanel x:Name="JobsPanel" Spacing="12" Width="380" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBlock x:Name="FreeText" Grid.Column="5" FontSize="12" Foreground="{ThemeResource NxText2}" VerticalAlignment="Center" />
            <Button Grid.Column="6" Padding="6,1" Background="Transparent" BorderThickness="0" Tag="app.palette" Click="OnNavButton">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Style="{StaticResource NxKeyHint}"><TextBlock Text="Ctrl Shift P" FontSize="11" /></Border>
                    <TextBlock Text="Lệnh" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Undo toast + errors (bottom right). -->
        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16" Spacing="8" MaxWidth="520">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
            <InfoBar x:Name="UndoBar" Severity="Success" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Hoàn tác" Click="OnUndoToast" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Omnibar overlay. -->
        <controls:Omnibar x:Name="OmnibarView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" />
    </Grid>
</Window>
